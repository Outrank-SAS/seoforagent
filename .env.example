# Copy to .env.local for local development. Only SFA_PROXY_SECRET is secret.

# Outrank agent API that every call is forwarded to (proxy and MCP tools).
OUTRANK_API_BASE=https://www.outrank.so/api/agent/v1

# Public origin of this site, used in prompts, MCP URLs, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=https://seoforagent.com

# Optional PostHog project key. Leave empty to load no analytics.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional Rewardful public key. Leave empty to load no affiliate tracking.
NEXT_PUBLIC_REWARDFUL_KEY=

# Set to true once the repository is public: shows the GitHub link and star count.
NEXT_PUBLIC_GITHUB_PUBLIC=

# Set to true once the seoforagent npm package is published: shows npx seoforagent init.
NEXT_PUBLIC_CLI_PUBLISHED=

# Server only, and secret: sent to Outrank as x-sfa-proxy-secret so it trusts x-sfa-client-ip. Set it in the host, not here.
SFA_PROXY_SECRET=
